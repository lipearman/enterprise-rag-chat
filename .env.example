# ============================================================
#  Enterprise RAG — Production Environment Variables
#  Copy this file to .env and fill in real values.
#  Never commit .env to version control.
# ============================================================

# ── Supabase (self-hosted or Supabase Cloud) ─────────────────
SUPABASE_URL=http://YOUR_SERVER:8000
SUPABASE_KEY=YOUR_SERVICE_ROLE_JWT

# ── Ollama Provider: "local" or "cloud" ──────────────────────
OLLAMA_PROVIDER=cloud

# Cloud (https://ollama.com)
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=YOUR_OLLAMA_CLOUD_KEY
OLLAMA_CLOUD_CHAT_MODEL=qwen2.5:14b-instruct
OLLAMA_CLOUD_GENERATE_MODEL=qwen2.5:14b-instruct

# Local (if OLLAMA_PROVIDER=local)
# OLLAMA_LOCAL_BASE_URL=http://YOUR_SERVER:11434
# OLLAMA_LOCAL_CHAT_MODEL=qwen2.5:14b-instruct

# ── Embedding (usually a separate local Ollama server) ───────
OLLAMA_EMBED_BASE_URL=http://YOUR_LLM_SERVER:11434
EMBED_MODEL=bge-m3:latest
EMBED_DIMENSION=1024

# ── Multi-tenant: default company when no company_code in request ──
COMPANY_CODE=mgcars

# ── RAG Feature Flags ────────────────────────────────────────
# Each AI step enabled adds ~10-30 s latency. Tune per environment.
RAG_MODE=full
ENABLE_AI_INTENT=true
ENABLE_QUERY_REWRITE=false
ENABLE_RERANKER=false
ENABLE_GROUNDING=false
ENABLE_METADATA_SEARCH=false
ENABLE_KNOWLEDGE_SEARCH=false
ENABLE_RELATIONSHIP_SEARCH=false

# ── (Build machine only — not needed on API server) ──────────
# START_URL=https://www.example.com
# CRAWL_DIR=/data/crawl-output
# LLM_MODEL=qwen2.5:14b-instruct
# OLLAMA_BASE_URL=http://YOUR_LLM_SERVER:11434
